# Datadog credentials for APM tracing + AI Guard.
# Copy this file to docker/.env and fill in real values:
#   cp docker/.env.example docker/.env
#
# DD_API_KEY: Organization Settings > API Keys
# DD_APP_KEY: Organization Settings > Application Keys
#             (must have the ai_guard_evaluate scope for AI Guard to work)
DD_API_KEY=
DD_APP_KEY=

# Datadog site your org is on (datadoghq.com, datadoghq.eu, us3.datadoghq.com, etc.)
DD_SITE=datadoghq.com

# Environment tag applied to traces and AI Guard evaluations.
DD_ENV=dev

# Master switch for AI Guard. Leave "false" until DD_API_KEY/DD_APP_KEY
# above are set -- the app also no-ops safely if this is left on without
# valid credentials, but keeping it off by default avoids failed calls.
DD_AI_GUARD_ENABLED=false
